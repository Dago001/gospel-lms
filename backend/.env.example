APP_NAME="GOSPEL LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gospel_lms
DB_USERNAME=gospel
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000,127.0.0.1:8000
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
PRIVATE_DISK_DRIVER=local

# --- Academy identity (shown on receipts and certificates; also editable in Admin > Settings) ---
ACADEMY_NAME="GOSPEL LMS"
ACADEMY_LEGAL_NAME=
ACADEMY_ADDRESS=
ACADEMY_SUPPORT_EMAIL=
ACADEMY_SIGNATORY_NAME=
ACADEMY_SIGNATORY_TITLE=

# --- Private object storage (S3-compatible). Set PRIVATE_DISK_DRIVER=s3 in production. ---
PRIVATE_S3_KEY=
PRIVATE_S3_SECRET=
PRIVATE_S3_BUCKET=
PRIVATE_S3_REGION=auto
PRIVATE_S3_ENDPOINT=
PRIVATE_S3_PATH_STYLE=true

# --- Paystack (use sk_test_/pk_test_ until go-live; PAYSTACK_MODE must match the key type) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MODE=test
PAYSTACK_BASE_URL=https://api.paystack.co
# Optional comma-separated allow-list of Paystack webhook source IPs (the HMAC signature is always required).
PAYSTACK_WEBHOOK_IPS=

# --- Video: Cloudflare Stream ---
VIDEO_PROVIDER=cloudflare
VIDEO_MAX_RATE=2.0
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM_B64=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# --- Zoom (Server-to-Server OAuth app) ---
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
ZOOM_HOST_USER=me

# --- Upload malware scanning (ClamAV daemon). Enable in production. ---
CLAMAV_ENABLED=false
CLAMAV_SOCKET=unix:///var/run/clamav/clamd.ctl

# --- Backups ---
BACKUP_PATH=
BACKUP_KEEP_DAYS=14
BACKUP_UPLOAD=false
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# --- Error monitoring (no-op while empty) ---
SENTRY_LARAVEL_DSN=
