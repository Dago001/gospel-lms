APP_NAME="GOSPEL LMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://learn.stbenedictsacademy.com.ng
FRONTEND_URL=https://learn.stbenedictsacademy.com.ng
APP_LOCALE=en
LOG_CHANNEL=daily
LOG_LEVEL=warning

# PostgreSQL created in cPanel > PostgreSQL Databases (names carry your account prefix)
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=stbenedi_lms
DB_USERNAME=stbenedi_lmsuser
DB_PASSWORD=CHANGE_ME

# Same-origin SPA cookie login
SANCTUM_STATEFUL_DOMAINS=learn.stbenedictsacademy.com.ng
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
PRIVATE_DISK_DRIVER=local

# Mail: create noreply@ in cPanel > Email Accounts, then use that mailbox
MAIL_MAILER=smtp
MAIL_HOST=mail.stbenedictsacademy.com.ng
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@stbenedictsacademy.com.ng
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=noreply@stbenedictsacademy.com.ng
MAIL_FROM_NAME="GOSPEL LMS"

ACADEMY_NAME="St Benedict's Academy"
ACADEMY_LEGAL_NAME=
ACADEMY_ADDRESS=
ACADEMY_SUPPORT_EMAIL=
ACADEMY_SIGNATORY_NAME=
ACADEMY_SIGNATORY_TITLE=

# Fill these when you have the accounts (see docs/DEPLOYMENT.md)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MODE=test
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM_B64=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=
